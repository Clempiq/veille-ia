---
import { ANGLES, longDate, shortDate, siblings } from "../lib/editions.js";
const { edition, isHome = false } = Astro.props;
const { newer, older } = siblings(edition.date);
const order = ["outils", "dev", "creation"];
const groups = order.map((key) => ({ key, ...ANGLES[key], items: edition.items.filter((i) => i.angle === key) }));
const counts = Object.fromEntries(groups.map((g) => [g.key, g.items.length]));
const total = edition.items.length;
const slug = (s) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60);
const HeadingTag = isHome ? "h2" : "h1";
---
<article class="edition" data-edition>
  <header class="ed-head">
    <p class="eyebrow">{isHome ? "Édition du jour" : "Édition"} · {total} actu{total > 1 ? "s" : ""}{edition.window ? ` · fenêtre du ${edition.window}` : ""}</p>
    <HeadingTag class="ed-title">{longDate(edition.date).replace(/^./, (c) => c.toUpperCase())}</HeadingTag>
    <p class="ed-intro">{edition.intro}</p>
  </header>

  {total > 0 && (
    <div class="filters" role="group" aria-label="Filtrer par thème">
      <button type="button" data-filter="all" aria-pressed="true">Tout <span>{total}</span></button>
      {groups.map((g) => (
        <button type="button" data-filter={g.key} aria-pressed="false" class={g.key} disabled={counts[g.key] === 0}>
          {g.label} <span>{counts[g.key]}</span>
        </button>
      ))}
    </div>
  )}

  {groups.map((g) => (
    <section class="angle" data-angle={g.key} aria-labelledby={`angle-${g.key}`}>
      <h2 id={`angle-${g.key}`} class={`angle-title ${g.key}`}>{g.long}</h2>
      {g.items.length === 0 ? (
        <p class="empty">Rien de neuf sur ce thème dans la fenêtre.</p>
      ) : (
        g.items.map((it) => (
          <div class="item" id={slug(it.title)}>
            <h3 class="item-title"><a href={`#${slug(it.title)}`}>{it.title}</a></h3>
            <p class="item-summary">{it.summary}</p>
            <p class="item-why"><strong>Pourquoi ça compte.</strong> {it.why}</p>
            <p class="item-sources">
              <span class="eyebrow">Sources</span>
              {it.sources.map((s, i) => (
                <>{i > 0 && <span class="dot" aria-hidden="true">·</span>}<a href={s.url} rel="noopener" target="_blank">{s.name}</a></>
              ))}
            </p>
          </div>
        ))
      )}
    </section>
  ))}

  <nav class="ed-nav" aria-label="Autres éditions">
    {older ? <a href={`/edition/${older.date}`} rel="prev">← {shortDate(older.date)}</a> : <span></span>}
    {isHome
      ? <a href="/archives">Toutes les éditions</a>
      : (newer ? <a href={`/edition/${newer.date}`} rel="next">{shortDate(newer.date)} →</a> : <a href="/">Aujourd'hui →</a>)}
  </nav>
</article>

<script>
  document.querySelectorAll("[data-edition]").forEach((root) => {
    const buttons = root.querySelectorAll("[data-filter]");
    const sections = root.querySelectorAll("[data-angle]");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const f = btn.getAttribute("data-filter");
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        sections.forEach((s) => { s.hidden = f !== "all" && s.getAttribute("data-angle") !== f; });
      });
    });
  });
</script>

<style>
  .ed-head { margin-bottom: 28px; }
  .ed-title { font-size: clamp(32px, 6vw, 46px); margin: 10px 0 14px; }
  .ed-intro { font: 400 19px/1.55 var(--serif); color: var(--ink); margin: 0; max-width: 64ch; }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 8px; position: sticky; top: 0; background: var(--paper); padding: 10px 0; z-index: 2; border-bottom: 1px solid var(--rule); }
  .filters button { font: 500 14px/1 var(--sans); color: var(--ink); background: transparent; border: 1px solid var(--rule); border-radius: 999px; padding: 9px 14px; cursor: pointer; min-height: 38px; }
  .filters button span { color: var(--ink-2); font-family: var(--mono); font-size: 12px; margin-left: 4px; }
  .filters button[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .filters button[aria-pressed="true"] span { color: inherit; opacity: 0.7; }
  .filters button:disabled { opacity: 0.4; cursor: default; }

  .angle { margin-top: 36px; }
  .angle-title { font-size: 15px; font-family: var(--mono); font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 4px; padding-left: 12px; border-left: 4px solid currentColor; line-height: 1.4; }
  .angle-title.outils { color: var(--c-outils); }
  .angle-title.dev { color: var(--c-dev); }
  .angle-title.creation { color: var(--c-creation); }
  .empty { color: var(--ink-2); font-style: italic; margin: 12px 0 0; }

  .item { padding: 22px 0; border-bottom: 1px solid var(--rule); scroll-margin-top: 70px; }
  .item:last-child { border-bottom: 0; }
  .item-title { font-size: 23px; margin: 0 0 10px; }
  .item-title a { color: var(--ink); text-decoration: none; }
  .item-title a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .item-summary { margin: 0 0 12px; }
  .item-why { margin: 0 0 12px; padding: 10px 14px; background: var(--paper-2); border-radius: 4px; font-size: 16px; }
  .item-sources { margin: 0; font-size: 15px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
  .item-sources .eyebrow { margin-right: 4px; }
  .dot { color: var(--ink-2); }

  .ed-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 40px; padding-top: 18px; border-top: 1px solid var(--ink); font: 500 15px/1.4 var(--sans); }
  .ed-nav a { text-decoration: none; }
  .ed-nav a:hover { text-decoration: underline; }
</style>
